{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TruckerFetch",
  "description": "Integrate published U.S. carrier, authority and insurance research through the TruckerFetch API, MCP and agent skills.",
  "colors": {
    "primary": "#FF6838",
    "light": "#FFD0B9",
    "dark": "#B83D16"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://truckerfetch.com"
  },
  "favicon": "/images/icon.svg",
  "fonts": {
    "family": "Poppins"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFF8F4",
      "dark": "#252321"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "scopes",
              "data-quality"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "guides/carrier-search",
              "guides/editions",
              "guides/renewals",
              "guides/exports",
              "guides/watchlists",
              "guides/webhooks"
            ]
          },
          {
            "group": "Reliability",
            "pages": [
              "rate-limits",
              "errors"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": {
          "source": "openapi.json",
          "directory": "api-reference"
        }
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "integrations/mcp",
              "integrations/agent-skills",
              "integrations/examples"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://truckerfetch.com/dashboard"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/truckerfetch"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://truckerfetch.com/dashboard/api/keys"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/truckerfetch/truckerfetch-api-docs"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "prefill": false
    }
  }
}
